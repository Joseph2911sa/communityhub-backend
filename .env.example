# ==========================================
# CommunityHub Backend — Variables de entorno (ejemplo)
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.
# ==========================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Base de datos ---
MONGODB_URI=mongodb://localhost:27017/communityhub

# --- Autenticación ---
JWT_SECRET=reemplaza_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
